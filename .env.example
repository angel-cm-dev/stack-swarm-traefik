# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Nombre del stack en Swarm
STACK_NAME=edge

# Dominio base: se publican traefik.<DOMAIN> y whoami.<DOMAIN>
DOMAIN=example.com

# Correo para Let's Encrypt (avisos de expiración)
ACME_EMAIL=admin@example.com

# Usa staging mientras pruebas para no agotar el rate limit de Let's Encrypt:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Usuario del dashboard en formato htpasswd (bcrypt). Genera el tuyo con:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'TuClaveSegura'
# El valor de abajo es un hash FICTICIO de ejemplo: no sirve para iniciar sesión, REEMPLÁZALO.
DASHBOARD_USERS='admin:$2y$05$Qy1x9d0mYb9mKcYh3s7uUeVb8b1mN0m0b2l3cN4yQ5Zr6s7T8u9vW'

TRAEFIK_LOG_LEVEL=INFO
WHOAMI_REPLICAS=2
